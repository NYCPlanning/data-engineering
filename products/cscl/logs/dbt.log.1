        WHEN saf_replicants.parity_side = 'R' THEN CASE WHEN rng.n = 1 THEN saf_replicants.l_high_hn ELSE saf_replicants.r_high_hn END
        WHEN saf_replicants.parity_side = 'L' THEN NULL
        ELSE saf_replicants.r_high_hn
    END AS r_high

