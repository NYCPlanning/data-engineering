    lgc4,
    borough,
    zipcode,
    created_by,
    created_date,
    modified_by,
    modified_date,
    LPAD(alt_segment_seqnum::INT::TEXT, 5, '0') AS alt_segment_seqnum,
    boe_preferred_lgc_flag AS boe_lgc_pointer,
    b5sc,
    sosindicator,
    feature_type AS feature_type_code,
    from_to_indicator,
    from_to_indicator = 'R' AS reversed,
    alt_segdata_type,
    seglocstatus,
    lgc5,
    lgc6,
    lgc7,
    lgc8,
    lgc9,
    twisted_parity_flag,
    globalid,
    lsubsect,
    rsubsect,
    sandist_ind,
    ogc_fid,
    data_library_version
FROM "cscl"."ar_cscl_duckdb_build"."dcp_cscl_altsegmentdata"
WHERE
    alt_segdata_type IS DISTINCT FROM 'S' -- S denotes an SAF record
    AND segmentid IS NOT NULL
  );

