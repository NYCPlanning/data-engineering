-- water owner to share an entity.
shoreline_edges AS (
    SELECT
        e.entity_id,
        e.node_lo,
        e.node_hi,
        e.is_arc,
        e.geom,
        'exterior' AS edge_type
    FROM edges AS e
    INNER JOIN has_water_neighbor AS hw
        ON e.node_lo = hw.node_lo AND e.node_hi = hw.node_hi AND e.is_arc = hw.is_arc
    WHERE NOT e.is_water
