          </mxGeometry>
        </mxCell>
        <mxCell id="e8" value="4 · package + upload" style="edgeStyle=orthogonalEdgeStyle;html=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="pg" target="pub">
