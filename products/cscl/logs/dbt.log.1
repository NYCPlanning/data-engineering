    as (
      

SELECT
    st_perimeter(d.geom) AS "SHAPE_Length",
    st_area(d.geom) AS "SHAPE_Area",
    d.borocode AS "BOROUGH",
    d.censusblock_2000_basic::text AS "CENSUSBLOCK_2000",
