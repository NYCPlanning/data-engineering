    create  table
      "cscl"."ar_cscl_duckdb_build"."thinfire_by_field__dbt_tmp"
  
    
    as (
      WITH combined AS (
    SELECT
        globalid,
        FORMAT_LION_TEXT(
            fire_company_type::TEXT,
            1,
            ' ',
            False,
            True
        ) AS fire_company_type,
    FORMAT_LION_TEXT(
            fire_company_number::TEXT,
            3,
            '0',
            False,
            False
        ) AS fire_company_number,
    FORMAT_LION_TEXT(
            fire_division::TEXT,
            2,
            '0',
            False,
            False
        ) AS fire_division,
    FORMAT_LION_TEXT(
            fire_battalion::TEXT,
            2,
            '0',
            False,
            False
        ) AS fire_battalion,
    FORMAT_LION_TEXT(
            borough::TEXT,
            1,
            ' ',
            False,
            True
        ) AS borough
    
    FROM "cscl"."ar_cscl_duckdb_build"."thinfire_by_field_unformatted"
)
SELECT
    *,
    fire_company_type || fire_company_number AS _thinfire_key
FROM combined
ORDER BY fire_company_type, fire_company_number
    );
    
  
