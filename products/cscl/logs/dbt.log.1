    create  table
      "cscl"."ar_cscl_duckdb_build"."int__primary_segments__dbt_tmp"
  
    
    as (
      

WITH seqnum AS (
    SELECT * FROM "cscl"."ar_cscl_duckdb_build"."int__nonstreetfeature_seqnum"
),

street_and_facecode AS (
    SELECT * FROM "cscl"."ar_cscl_duckdb_build"."int__streetcode_and_facecode"
),

feature_type_codes AS (
    SELECT * FROM "cscl"."ar_cscl_duckdb_build"."feature_type_codes"
),

primary_segments AS (SELECT
            source.segmentid,
            -- TODO all these if elses are a little inelegant, this should be reworked
            -- there's only one row where this actually makes a difference. Will report to GR
                source.boroughcode,
            source.legacy_segmentid,
                source.from_level_code,
                source.to_level_code,
                source.segment_seqnum,
            source.feature_type_code,
            ST_LINEMERGE(source.geom) AS geom, -- already linear; merge as linearize() did
            source.geom AS raw_geom,
            source.shape_length,
            source.feature_type,
            source.source_table,
            source.globalid
        FROM "cscl"."ar_cscl_duckdb_build"."stg__centerline" AS source
        UNION ALL
        SELECT
            source.segmentid,
            -- TODO all these if elses are a little inelegant, this should be reworked
            NULL AS boroughcode,
            NULL::INT AS legacy_segmentid,
                NULL AS from_level_code,
                NULL AS to_level_code,
                source.segment_seqnum,
            source.feature_type_code,
            ST_LINEMERGE(source.geom) AS geom, -- already linear; merge as linearize() did
            source.geom AS raw_geom,
            source.shape_length,
            source.feature_type,
            source.source_table,
            source.globalid
        FROM "cscl"."ar_cscl_duckdb_build"."stg__shoreline" AS source
        UNION ALL
        SELECT
            source.segmentid,
            -- TODO all these if elses are a little inelegant, this should be reworked
            NULL AS boroughcode,
            source.legacy_segmentid,
                source.from_level_code,
                source.to_level_code,
                source.segment_seqnum,
            source.feature_type_code,
            ST_LINEMERGE(source.geom) AS geom, -- already linear; merge as linearize() did
            source.geom AS raw_geom,
            source.shape_length,
            source.feature_type,
            source.source_table,
            source.globalid
        FROM "cscl"."ar_cscl_duckdb_build"."stg__rail_and_subway" AS source
        UNION ALL
        SELECT
            source.segmentid,
            -- TODO all these if elses are a little inelegant, this should be reworked
            NULL AS boroughcode,
            source.legacy_segmentid::INT AS legacy_segmentid,
                NULL AS from_level_code,
                NULL AS to_level_code,
                seqnum.segment_seqnum,
            source.feature_type_code,
            ST_LINEMERGE(source.geom) AS geom, -- already linear; merge as linearize() did
            source.geom AS raw_geom,
            source.shape_length,
            source.feature_type,
            source.source_table,
            source.globalid
        FROM "cscl"."ar_cscl_duckdb_build"."stg__nonstreetfeatures" AS source
        LEFT JOIN seqnum
                ON
                    seqnum.source_table = 'nonstreetfeatures'
                    AND source.globalid = seqnum.globalid
),

segment_attributes AS (
    SELECT
        COALESCE(primary_segments.boroughcode, street_and_facecode.boroughcode) AS boroughcode,
        street_and_facecode.face_code,
        primary_segments.segment_seqnum,
        primary_segments.segmentid,
        primary_segments.from_level_code,
        primary_segments.to_level_code,
        primary_segments.legacy_segmentid,
        primary_segments.feature_type_code,
        primary_segments.geom,
        primary_segments.raw_geom,
        ST_LINEINTERPOLATEPOINT(primary_segments.geom, 0.5) AS midpoint,
        ST_STARTPOINT(primary_segments.geom) AS start_point,
        ST_ENDPOINT(primary_segments.geom) AS end_point,
        primary_segments.shape_length,
        street_and_facecode.five_digit_street_code,
        street_and_facecode.lgc1,
        street_and_facecode.lgc2,
        street_and_facecode.lgc3,
