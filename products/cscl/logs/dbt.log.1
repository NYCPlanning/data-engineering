-- One row per fire battalion, from its exterior edges, before noise-ring removal.

WITH faces AS MATERIALIZED (
    SELECT
        entity_id,
        face,
        st_pointonsurface(face) AS face_pt
    FROM (
        SELECT
            entity_id,
