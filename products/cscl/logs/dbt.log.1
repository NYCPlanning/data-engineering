    FROM "cscl"."ar_cscl_duckdb_build"."int__primary_segments"
    UNION ALL
    SELECT
        "boroughcode",
  "face_code",
  "segment_seqnum",
  "segmentid",
  "from_level_code",
  "to_level_code",
  "legacy_segmentid",
  "feature_type_code",
  "geom",
  "raw_geom",
  "midpoint",
  "start_point",
  "end_point",
  "shape_length",
