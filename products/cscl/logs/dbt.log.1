    create  table
      "cscl"."ar_cscl_duckdb_build"."gdb_nycb2010wi__dbt_tmp"
  
    
    as (
      

-- 2010 census blocks (entity_id is BCTCB2010: borocode(1) || tract(6) || block(4)),
-- water included (the *wi variant). Boundaries come from the AtomicPolygon topology
-- (int__boundary__cb2010wi); columns, column order and types match the published layer.

WITH boundaries AS (
    SELECT
        entity_id,
        st_multi(geom) AS geom
    FROM "cscl"."ar_cscl_duckdb_build"."int__boundary__cb2010wi"
)

SELECT
    right(b.entity_id, 4)::varchar(4) AS "CB2010",
    left(b.entity_id, 1)::varchar(1) AS "BoroCode",
    boro.boroname::varchar(32) AS "BoroName",
    substr(b.entity_id, 2, 6)::varchar(6) AS "CT2010",
    b.entity_id::varchar(11) AS "BCTCB2010",
    b.geom,
    st_perimeter(b.geom) AS "SHAPE_Length",
    st_area(b.geom) AS "SHAPE_Area"
FROM boundaries AS b
LEFT JOIN "cscl"."ar_cscl_duckdb_build"."stg__borough" AS boro ON left(b.entity_id, 1) = boro.borocode
    );
    
  
