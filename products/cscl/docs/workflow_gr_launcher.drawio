        </mxCell>
        <mxCell id="cscl" value="&lt;b&gt;CSCL DB&lt;/b&gt;&lt;br&gt;OTI Oracle" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="160" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="private" value="&lt;b&gt;edm-private&lt;/b&gt;&lt;br&gt;&lt;br&gt;qa_app/inbox/dcp_cscl_gdb/{version}/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="320" y="80" width="200" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="recipes" value="&lt;b&gt;edm-recipes&lt;/b&gt;&lt;br&gt;&lt;br&gt;dcp_cscl_* layers, {version}&lt;br&gt;(tagged latest)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="640" y="80" width="200" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="pg" value="&lt;b&gt;CSCL build&lt;/b&gt;&lt;br&gt;DuckDB build database + dbt" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="940" y="80" width="200" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="app" value="&lt;b&gt;QA app&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;div style=&quot;text-align:left&quot;&gt;- Inbox Ingest: ingest a version&lt;br&gt;- CSCL Builds: run build,&lt;br&gt;&amp;nbsp; run status + drafts&lt;br&gt;- CSCL QA: diffs&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="320" y="420" width="200" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="gha" value="&lt;b&gt;GitHub Actions&lt;/b&gt;&lt;br&gt;&lt;br&gt;ingest_single (dcp_cscl_gdb)&lt;br&gt;build.yml (cscl)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="640" y="420" width="200" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="pub" value="&lt;b&gt;edm-publishing&lt;/b&gt;&lt;br&gt;&lt;br&gt;db-cscl/build/{build name}/&lt;br&gt;promoted to draft" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="940" y="420" width="200" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="e1" value="1 · export + zip&lt;br&gt;Working GDB" style="edgeStyle=orthogonalEdgeStyle;html=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cscl" target="grbox">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="2 · upload zip to inbox/&lt;br&gt;(S3 client)" style="edgeStyle=orthogonalEdgeStyle;html=1;labelBackgroundColor=#ffffff;entryX=0.25;entryY=1;" edge="1" parent="1" source="grbox" target="private">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="230" y="460"/>
              <mxPoint x="230" y="260"/>
              <mxPoint x="370" y="260"/>
