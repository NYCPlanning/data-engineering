coalesce(
    CASE
        WHEN hn.l_low LIKE '%-%'
            THEN (
                regexp_replace(split_part(hn.l_low, '-', 1), '\D', '', 'g')
                || lpad(regexp_replace(split_part(hn.l_low, '-', 2), '\D', '', 'g'), 3, '0')
            )::int
        ELSE nullif(regexp_replace(hn.l_low, '\D', '', 'g'), '')::int
    END, 0
)
 AS "FromLeft",
        
coalesce(
    CASE
        WHEN hn.l_high LIKE '%-%'
            THEN (
                regexp_replace(split_part(hn.l_high, '-', 1), '\D', '', 'g')
                || lpad(regexp_replace(split_part(hn.l_high, '-', 2), '\D', '', 'g'), 3, '0')
            )::int
        ELSE nullif(regexp_replace(hn.l_high, '\D', '', 'g'), '')::int
    END, 0
)
 AS "ToLeft",
        
coalesce(
    CASE
        WHEN hn.r_low LIKE '%-%'
            THEN (
                regexp_replace(split_part(hn.r_low, '-', 1), '\D', '', 'g')
                || lpad(regexp_replace(split_part(hn.r_low, '-', 2), '\D', '', 'g'), 3, '0')
            )::int
        ELSE nullif(regexp_replace(hn.r_low, '\D', '', 'g'), '')::int
    END, 0
)
 AS "FromRight",
        
coalesce(
    CASE
        WHEN hn.r_high LIKE '%-%'
            THEN (
                regexp_replace(split_part(hn.r_high, '-', 1), '\D', '', 'g')
                || lpad(regexp_replace(split_part(hn.r_high, '-', 2), '\D', '', 'g'), 3, '0')
