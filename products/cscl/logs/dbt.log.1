    upper((SELECT value FROM "cscl"."ar_cscl_duckdb_build"."config" WHERE key = 'ldf_previous_version')) AS old_lion_release,
    strftime((SELECT value FROM "cscl"."ar_cscl_duckdb_build"."config" WHERE key = 'ldf_old_release_date')::date, '%m%d%Y') AS old_lion_release_date,
    upper((SELECT value FROM "cscl"."ar_cscl_duckdb_build"."config" WHERE key = 'ldf_new_release')) AS new_lion_release,
    strftime((SELECT value FROM "cscl"."ar_cscl_duckdb_build"."config" WHERE key = 'ldf_new_release_date')::date, '%m%d%Y') AS new_lion_release_date,
    this_edition.record_count,
    previous_edition.cumulative_record_number
    + previous_edition.record_count AS cumulative_record_number
FROM previous_edition
CROSS JOIN this_edition
    );
    
  
