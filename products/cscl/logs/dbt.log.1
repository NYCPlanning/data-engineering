    CASE
        WHEN NOT (lion.segment_type NOT IN ('G', 'F') AND coalesce(lion.feature_type_code, '0') IN ('0', '6', 'W')) THEN NULL
        WHEN saf_replicants.parity_side = 'R' THEN CASE WHEN rng.n = 1 THEN saf_replicants.l_low_hn ELSE saf_replicants.r_low_hn END
        WHEN saf_replicants.parity_side = 'L' THEN NULL
