[0m00:48:54.347478 [debug] [Thread-2 (]: On model.cscl.int__split_election_district: /* {"app": "dbt", "dbt_version": "1.12.5", "profile_name": "dcp-de-postgres", "target_name": "duckdb", "node_id": "model.cscl.int__split_election_district"} */

    

    create  table
      "cscl"."ar_cscl_duckdb_build"."int__split_election_district__dbt_tmp"
  
    
    as (
      
WITH sedat AS (
    SELECT * FROM "cscl"."ar_cscl_duckdb_build"."stg__segment_sedat"
),
agg AS (
    SELECT
        segmentid,
        lionkey,
        left(lionkey, 1) AS boroughcode,
        array_agg(side) AS sedat_sides
    FROM sedat
    GROUP BY segmentid, lionkey
)
SELECT
    *,
    CASE
        -- staging table has validation that only valid values are '1' and '2'
        -- cases are then both, all 1, all 2, or none
        WHEN list_contains(sedat_sides, '1') AND list_contains(sedat_sides, '2') THEN 'B'
        WHEN list_contains(sedat_sides, '1') THEN 'L'
        WHEN list_contains(sedat_sides, '2') THEN 'R'
    END AS split_election_district_flag
FROM agg
    );
    
  
