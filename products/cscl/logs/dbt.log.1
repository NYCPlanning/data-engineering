    NULL::INT AS x_coord,
    NULL::INT AS y_coord,
    saf.saf_globalid,
    saf.saf_source_table,
    saf.generic,
    saf.roadbed
FROM saf
LEFT JOIN altsegdata ON saf.saf_globalid = altsegdata.globalid
LEFT JOIN feature_names
    ON (altsegdata.b5sc || altsegdata.lgc1) = feature_names.b7sc
WHERE saf.saftype = 'O'
  );

