    feature_names.globalid
FROM feature_names
LEFT JOIN words ON feature_names.lookup_key LIKE '% ' || words.word --TODO recursive?
WHERE feature_names.exception_flag = 'Y' AND feature_names.enders_flag = 'N'
  );

