    SELECT * FROM "cscl"."ar_cscl_duckdb_build"."dcp_cscl_universalword"
),
ranked AS (
    SELECT
        LEFT(full_name, 1) AS first_letter,
        ROW_NUMBER() OVER (PARTITION BY LEFT(full_name, 1) ORDER BY full_name) AS row_number,
        *
    FROM word_table
)
SELECT
