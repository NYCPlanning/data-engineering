  create view "cscl"."ar_cscl_duckdb_build"."int__special_sedat__dbt_tmp" as (
    WITH special_sedat AS (
    SELECT * FROM "cscl"."ar_cscl_duckdb_build"."dcp_cscl_specialsedat"
),
feature_name AS (
    SELECT * FROM "cscl"."ar_cscl_duckdb_build"."stg__facecode_and_featurename_principal"
)
SELECT
    special_sedat.lionkey,
    special_sedat.parity,
    feature_name.lookup_key AS street_name,
    CASE
        WHEN special_sedat.side = '1' THEN 'L'
        WHEN special_sedat.side = '2' THEN 'R'
