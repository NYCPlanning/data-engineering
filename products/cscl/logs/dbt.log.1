    neighborhood_code,
    RPAD(neighborhood_name, 75, ' ') AS neighborhood_name,  -- Pad to 75 chars with spaces
    LPAD(puma_int::TEXT, 5, '0') AS puma  -- Zero-pad to 5 chars
FROM source
ORDER BY borough, censustract
    );
    
  
