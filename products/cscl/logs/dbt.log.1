    create  table
      "cscl"."ar_cscl_duckdb_build"."gdb_nyss__dbt_tmp"
  
    
    as (
      

-- State senate districts. Boundaries come from the AtomicPolygon topology
-- (int__boundary__ss); columns, column order and types match the published layer.

WITH boundaries AS (
    SELECT
        entity_id,
        st_multi(geom) AS geom
    FROM "cscl"."ar_cscl_duckdb_build"."int__boundary__ss"
)

SELECT
    b.entity_id::smallint AS "StSenDist",
    b.geom,
