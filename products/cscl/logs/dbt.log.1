  create view "cscl"."ar_cscl_duckdb_build"."int__boundary__hc_edges__dbt_tmp" as (
    -- Every topology edge classified relative to each health center district that owns it. Land only.

WITH edges AS (
    SELECT
        e.node_lo, e.node_hi, e.is_arc, e.geom, e.atomicid, m.health_center AS entity_id,
        e.water_flag = '1' AS is_water
