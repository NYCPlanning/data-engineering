    so.topo_method
FROM chosen AS so
LEFT JOIN "cscl"."ar_cscl_duckdb_build"."stg__atomicpolygons" AS left_poly ON so.left_atomicid = left_poly.atomicid
LEFT JOIN "cscl"."ar_cscl_duckdb_build"."stg__atomicpolygons" AS right_poly ON so.right_atomicid = right_poly.atomicid
    );
    
  
