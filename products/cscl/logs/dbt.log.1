        from_level_code AS "NodeLevelF",
        to_level_code AS "NodeLevelT",
        continuous_parity_flag AS "ConParity",
        twisted_parity_flag AS "Twisted",
        lpad(coalesce(rw_type::text, ''), 2, ' ') AS "RW_TYPE",
