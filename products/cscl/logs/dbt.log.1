    create  table
      "cscl"."ar_cscl_duckdb_build"."snd__dbt_tmp"
  
    
    as (
      WITH source AS (
    SELECT "record_type",
  "boroughcode",
  "place_name",
  "primary_flag",
  "principal_flag",
  "b10sc",
  "filler_sndn6",
  "numeric_name_indicator",
  "geographic_feature_type",
  "name_length",
  "full_name",
  "filler_sndn10",
