        WHEN lion.continuous_parity_flag = 'R' THEN NULL
        ELSE nullif(lion.l_low_hn, '0')
    END AS l_low,
    CASE
        WHEN NOT (lion.segment_type NOT IN ('G', 'F') AND coalesce(lion.feature_type_code, '0') IN ('0', '6', 'W')) THEN NULL
        WHEN lion.continuous_parity_flag = 'L' THEN CASE WHEN rng.n = 1 THEN nullif(lion.l_high_hn, '0') ELSE nullif(lion.r_high_hn, '0') END
        WHEN lion.continuous_parity_flag = 'R' THEN NULL
        ELSE nullif(lion.l_high_hn, '0')
    END AS l_high,
    CASE
        WHEN NOT (lion.segment_type NOT IN ('G', 'F') AND coalesce(lion.feature_type_code, '0') IN ('0', '6', 'W')) THEN NULL
        WHEN lion.continuous_parity_flag = 'R' THEN CASE WHEN rng.n = 1 THEN nullif(lion.l_low_hn, '0') ELSE nullif(lion.r_low_hn, '0') END
        WHEN lion.continuous_parity_flag = 'L' THEN NULL
        ELSE nullif(lion.r_low_hn, '0')
    END AS r_low,
    CASE
        WHEN NOT (lion.segment_type NOT IN ('G', 'F') AND coalesce(lion.feature_type_code, '0') IN ('0', '6', 'W')) THEN NULL
        WHEN lion.continuous_parity_flag = 'R' THEN CASE WHEN rng.n = 1 THEN nullif(lion.l_high_hn, '0') ELSE nullif(lion.r_high_hn, '0') END
        WHEN lion.continuous_parity_flag = 'L' THEN NULL
        ELSE nullif(lion.r_high_hn, '0')
