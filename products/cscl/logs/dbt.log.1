    other_abbreviation_2,
    other_abbreviation_3,
    other_abbreviation_4,
    other_abbreviation_5,
    other_abbreviation_6,
    other_abbreviation_7,
    other_abbreviation_8,
    other_abbreviation_9,
    other_abbreviation_10
FROM ranked
ORDER BY full_name
    );
    
  
