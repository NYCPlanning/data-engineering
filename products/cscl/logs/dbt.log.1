    create  table
      "cscl"."ar_cscl_duckdb_build"."ldf_base__dbt_tmp"
  
    
    as (
      /*
The LDF record file. Node and segment records use different layouts, so each block is
formatted against its own seed and the two are concatenated - `select_rows_as_text` only
handles one layout at a time.

Ordering is by the cumulative record number already embedded at positions 91-100, so the
file's order and its numbering cannot disagree.
*/

WITH nodes AS (
    WITH source AS (
    SELECT "record_type",
  "filler_ldfn1",
  "action_code",
  "filler_ldfn2",
  "x_coord",
  "y_coord",
  "filler_ldfn3",
  "nodeid",
  "filler_ldfn4",
  "destination_x_coord",
  "destination_y_coord",
  "filler_ldfn5",
  "cumulative_record_number"
    FROM "cscl"."ar_cscl_duckdb_build"."ldf_n_by_field"
)
SELECT rtrim(ltrim(replace(replace(source::text, ',', ''), '"', ''), '('), ')') AS dat_column
FROM source
),

segments AS (
    WITH source AS (
    SELECT "record_type",
  "filler_ldfs1",
  "action_code",
  "filler_ldfs2",
  "old_id",
  "filler_ldfs3",
  "old_from_nodeid",
  "old_to_nodeid",
  "filler_ldfs4",
  "new_id",
  "filler_ldfs5",
  "new_from_nodeid",
  "new_to_nodeid",
  "filler_ldfs6",
  "cumulative_record_number"
    FROM "cscl"."ar_cscl_duckdb_build"."ldf_segment_by_field"
)
SELECT rtrim(ltrim(replace(replace(source::text, ',', ''), '"', ''), '('), ')') AS dat_column
FROM source
),

combined AS (
    SELECT dat_column FROM nodes
    UNION ALL
    SELECT dat_column FROM segments
)

SELECT dat_column
FROM combined
ORDER BY substring(dat_column, 91, 10)
    );
    
  
