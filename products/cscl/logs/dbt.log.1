)

-- one row per (crossed edge, crossing point)
SELECT
    a_lo AS node_lo,
    a_hi AS node_hi,
    node_id,
    geom
FROM numbered
UNION ALL
SELECT
    b_lo AS node_lo,
    b_hi AS node_hi,
    node_id,
    geom
FROM numbered
    );
    
  
