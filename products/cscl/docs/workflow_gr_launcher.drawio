          </mxGeometry>
        </mxCell>
        <mxCell id="e3" value="3, 4 · pick version,&lt;br&gt;run ingest, then build" style="edgeStyle=orthogonalEdgeStyle;html=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="grbox" target="app">
