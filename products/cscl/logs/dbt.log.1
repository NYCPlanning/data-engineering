    END AS feature_type_code,
    'nonstreetfeatures' AS feature_type,
    'nonstreetfeatures' AS source_table
FROM "cscl"."ar_cscl_duckdb_build"."dcp_cscl_nonstreetfeatures"
    );
    
  
