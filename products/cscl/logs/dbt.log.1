    create  table
      "cscl"."ar_cscl_duckdb_build"."int__boundary__sd_boro_raw__dbt_tmp"
  
    
    as (
      

-- One row per school district within a borough, before noise-ring removal.

WITH faces AS MATERIALIZED (
    SELECT
        entity_id,
        face,
        st_pointonsurface(face) AS face_pt
    FROM (
        SELECT
            entity_id,
            unnest(st_dump(polygonized)).geom AS face
        FROM (
            SELECT
                entity_id,
                st_polygonize(list(geom)) AS polygonized
            FROM "cscl"."ar_cscl_duckdb_build"."int__boundary__sd_boro_edges"
            WHERE edge_type = 'exterior'
            GROUP BY entity_id
        ) AS by_entity
    ) AS dumped
),

-- Which AP each face's interior point falls in. A face is bounded by the district's
-- exterior edges, so it never holds both member and non-member APs: one point decides
-- (st_contains of every member AP's point against large faces is far slower in DuckDB,
-- which doesn't cache prepared geometries). Sliver faces fall in no AP and drop out.
face_aps AS MATERIALIZED (
    SELECT DISTINCT
        f.entity_id,
        f.face,
        a.atomicid
    FROM faces AS f
    INNER JOIN "cscl"."ar_cscl_duckdb_build"."stg__atomicpolygons" AS a ON st_intersects(a.geom, f.face_pt)
),

kept AS (
    SELECT DISTINCT
        fa.entity_id,
        fa.face
    FROM face_aps AS fa
    INNER JOIN "cscl"."ar_cscl_duckdb_build"."int__topology__ap_entities" AS m
        ON fa.atomicid = m.atomicid AND fa.entity_id = m.sd_boro
)

-- kept faces share exact, already-noded edges, so this union only dissolves them
SELECT
    entity_id,
    st_union_agg(face) AS geom
FROM kept
GROUP BY entity_id

    );
    
  
