    sc.starts_on_node,
    sc.ends_on_node,
    sc.n_unmatched_steps,
    sc.n_edges,
    sc.n_path_edges,
    sc.max_len_diff_ft,
    sc.max_offset_ft,
    sc.n_left_aps,
    sc.n_right_aps
FROM scoped AS sc
LEFT JOIN probe_2ft AS p2 ON sc.globalid = p2.globalid
    );
    
  
