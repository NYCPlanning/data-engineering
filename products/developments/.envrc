source_up

export BUILD_ENGINE_DB=db-devdb
export DATASET=developments
# matches the build workflow: on Postgres 18, JIT turns several DevDB queries from minutes into hours
export PGOPTIONS="-c jit=off"

# Load local .env if it exists
if [ -f .env ]; then
    dotenv .env
    watch_file .env
fi

export BUILD_ENGINE=$(echo_build_engine)
