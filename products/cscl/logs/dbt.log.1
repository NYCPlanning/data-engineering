    "CB2010" AS cb2010,
    "BoroCode" AS borocode,
    "BoroName" AS boroname,
    "CT2010" AS ct2010,
    round("SHAPE_Length"::numeric) AS shape_length,
    round("SHAPE_Area"::numeric, -1) AS shape_area
FROM "cscl"."ar_cscl_duckdb_build"."gdb_nycb2010"
    );
    
  
