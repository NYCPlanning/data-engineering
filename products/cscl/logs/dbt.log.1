    create  table
      "cscl"."ar_cscl_duckdb_build"."thinlion_by_field_unformatted__dbt_tmp"
  
    
    as (
      WITH atomic_polygons_with_lookups AS (
    SELECT
        ap.atomicid,
        ap.borocode AS borough,
        ap.dynamic_block,
        
        -- census 2020
            ap.censustract_2020,
            ap.censustract_2020_basic,
            ap.censustract_2020_suffix,
            ap.censusblock_2020_basic,
            ap.censusblock_2020_suffix,
        
        -- census 2010
            ap.censustract_2010,
            ap.censustract_2010_basic,
            ap.censustract_2010_suffix,
            ap.censusblock_2010_basic,
            ap.censusblock_2010_suffix,
        
        -- census 2000
            ap.censustract_2000,
            ap.censustract_2000_basic,
            ap.censustract_2000_suffix,
            ap.censusblock_2000_basic,
            ap.censusblock_2000_suffix,
        
        -- 1990 is a little weird
        ap.censustract_1990_basic,
        CASE
            WHEN ap.censustract_1990_suffix IS NULL OR ap.censustract_1990_suffix = 0 THEN ''
            ELSE LPAD(ap.censustract_1990_suffix::TEXT, 2, '0')
        END AS censustract_1990_suffix,

        ct2020.cd_eligibility AS community_development_eligibility,
        ap.commdist AS community_district,
        ct2010.mcea AS minor_census_economic_area,
        CASE
