# Settings for deploy.sh. Copy to deploy/.env (gitignored) and fill in.
# Blank optional values fall back to the defaults shown in deploy.sh.

# --- where (required) ---------------------------------------------------------------
AZ_SUBSCRIPTION=                  # blank = current 'az account show' subscription
AZ_RESOURCE_GROUP=                # RG for the gateway app, doctor job and identity
AZ_LOCATION=westus2
ACA_ENVIRONMENT=                  # existing Container Apps environment name
ACA_ENVIRONMENT_RESOURCE_GROUP=   # blank = AZ_RESOURCE_GROUP
                                  # must be internal-only (VNet, no public IP); see GW_INGRESS

# --- registry -------------------------------------------------------------------------
ACR_NAME=dcpdecontainers-c8eze3cfayagfcaq
ACR_RESOURCE_GROUP=               # blank = let az find it
GW_IMAGE_SOURCE=docker.io/versity/versitygw:v1.10.0   # pinned in inv-k0d.12
GW_IMAGE=versity/versitygw:v1.10.0                    # repo:tag inside ACR
DOCKERHUB_USERNAME=               # optional: avoids Docker Hub's anonymous pull limit during az acr import
DOCKERHUB_TOKEN=

# --- storage (required) ---------------------------------------------------------------
STORAGE_ACCOUNT=                  # the Blob account the gateway fronts
STORAGE_RESOURCE_GROUP=           # blank = AZ_RESOURCE_GROUP
STORAGE_DATA_ROLE_SCOPE=          # blank = the whole account; or a container scope:
                                  # <account id>/blobServices/default/containers/<name>
                                  # (then Storage Blob Delegator on the account is also needed)

# --- gateway app ----------------------------------------------------------------------
GW_APP_NAME=az-blob-gateway          # FQDN becomes <name>.<env default domain>
GW_IDENTITY_NAME=az-blob-gateway-id  # user-assigned managed identity (created if missing)
GW_INGRESS=external               # 'external' on an internal env = reachable from the VNet/citynet, not
                                  # the internet. 'internal' = only apps in the same env (citynet can't reach it).
GW_CPU=1.0
GW_MEMORY=2Gi                     # versitygw holds each multipart part in memory: part size x parts in flight
GW_MIN_REPLICAS=1
GW_MAX_REPLICAS=1
GW_WORKLOAD_PROFILE=              # blank = env default (e.g. Consumption)
GW_DEBUG=false                    # true logs versitygw debug output (shows copy fallbacks)

# S3 credentials clients use against the gateway (versitygw root user).
GW_ACCESS_KEY_ID=gateway
GW_SECRET_ACCESS_KEY=             # either a literal (stored as a Container Apps secret) ...
GW_SECRET_KV_URL=                 # ... or a Key Vault secret URL, read by the identity
KEYVAULT_NAME=                    # with GW_SECRET_KV_URL: lets the script check 'Key Vault Secrets User'
KEYVAULT_RESOURCE_GROUP=

# --- private DNS checks (optional; check-only) ----------------------------------------
PRIVATE_DNS_RESOURCE_GROUP=       # RG holding privatelink.blob.core.windows.net and the env-domain zone
PRIVATE_DNS_SUBSCRIPTION=         # blank = AZ_SUBSCRIPTION

# --- doctor job -----------------------------------------------------------------------
DOCTOR_JOB_NAME=az-blob-gateway-doctor
DOCTOR_IMAGE=                     # blank = az-blob-gateway-doctor:<git short sha>, built with az acr build
DOCTOR_BUCKET=az-blob-gateway-doctor      # container the doctor tests in (created + removed if missing)
DOCTOR_SIZE=1G                    # large-file layer; set 5G for the full check
DOCTOR_PART_SIZE=32MiB
DOCTOR_CPU=1.0
DOCTOR_MEMORY=2Gi
DOCTOR_TIMEOUT=3600               # replica timeout, seconds
