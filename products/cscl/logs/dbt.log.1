[0m00:53:37.172651 [debug] [Thread-2 (]: On model.cscl.int__address_points: /* {"app": "dbt", "dbt_version": "1.12.5", "profile_name": "dcp-de-postgres", "target_name": "duckdb", "node_id": "model.cscl.int__address_points"} */

    

    create  table
      "cscl"."ar_cscl_duckdb_build"."int__address_points__dbt_tmp"
  
    
    as (
      

WITH address_points AS (
    SELECT * FROM "cscl"."ar_cscl_duckdb_build"."dcp_cscl_addresspoints"
),
street_names AS (
    SELECT * FROM "cscl"."ar_cscl_duckdb_build"."dcp_cscl_streetname"
    WHERE principal_flag = 'Y'
)
SELECT
    address_points.addresspointid,
    address_points.segmentid,
    address_points.b7sc_vanity,
    address_points.b7sc_actual,
    address_points.sosindicator,
    CASE
        WHEN street_names.snd_feature_type IN ('E', 'F') AND address_points.house_number_suffix IS NOT NULL
            THEN
                -- Last character is A, B, etc -> converted to 1, 2, etc
                (
                    10000 * COALESCE(ASCII(RIGHT(address_points.house_number_suffix, 1)) - 64, 0)
                    + address_points.house_number::INT
                )::TEXT
        WHEN address_points.hyphen_type = 'R'
            THEN TRIM(SPLIT_PART(address_points.house_number, '-', 1))
        ELSE address_points.house_number
    END AS house_number,
    CASE
        WHEN street_names.snd_feature_type IN ('E', 'F')
            THEN TRIM(SPLIT_PART(address_points.house_number_suffix, '-', 1))
        ELSE address_points.house_number_suffix
    END AS house_number_suffix,
    address_points.house_number AS plain_house_number,
    address_points.house_number_suffix AS plain_house_number_suffix,
    address_points.house_number_range,
    address_points.house_number_range_suffix,
    address_points.hyphen_type,
    street_names.snd_feature_type,
    address_points.globalid,
    address_points.geom
FROM address_points
LEFT JOIN street_names
    ON address_points.b7sc_actual = street_names.b7sc AND street_names.principal_flag = 'Y'
    );
    
  
