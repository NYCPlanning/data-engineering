<mxfile>
  <diagram id="gr-launcher" name="GR launcher">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="700" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="do" value="Digital Ocean&lt;br&gt;(DE infrastructure)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C6E5F6;strokeColor=#7EB0D5;dashed=1;verticalAlign=top;align=left;spacingLeft=20;spacingTop=10;fontStyle=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="270" y="20" width="900" height="640" as="geometry"/>
        </mxCell>
        <mxCell id="grbox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#C6E5F6;strokeColor=#7EB0D5;dashed=1;" vertex="1" parent="1">
