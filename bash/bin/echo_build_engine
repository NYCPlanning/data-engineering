#!/bin/bash
#
# Set BUILD_ENGINE connection string with schema search path
#
# Usage:
#   eval $(set_build_engine)
#
# This constructs BUILD_ENGINE from BUILD_ENGINE_SERVER, BUILD_ENGINE_DB, and BUILD_ENGINE_SCHEMA
#
options="--search_path%3D${BUILD_ENGINE_SCHEMA},public"
# libpq ignores PGOPTIONS when the connection string sets options, so carry it over
if [ -n "${PGOPTIONS}" ]; then
    pgoptions=${PGOPTIONS// /%20}
    options="${options}%20${pgoptions//=/%3D}"
fi
echo ${BUILD_ENGINE_SERVER}/${BUILD_ENGINE_DB}?options=${options}
