    FROM "cscl"."ar_cscl_duckdb_build"."int__boundary__cg"
)

SELECT
    b.entity_id::smallint AS "CongDist",
    b.geom,
    st_perimeter(b.geom) AS "SHAPE_Length",
    st_area(b.geom) AS "SHAPE_Area"
FROM boundaries AS b
    );
    
  
