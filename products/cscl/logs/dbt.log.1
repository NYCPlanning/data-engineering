                OR (a.assigned_right IS NOT NULL AND re.atomicid IS NULL)
                THEN 'out_of_scope'
            WHEN a.is_matched THEN 'edges'
            ELSE 'probe_fallback'
        END AS method
    FROM assigned AS a
    LEFT JOIN "cscl"."ar_cscl_duckdb_build"."int__topology__ap_entities" AS le ON a.assigned_left = le.atomicid
    LEFT JOIN "cscl"."ar_cscl_duckdb_build"."int__topology__ap_entities" AS re ON a.assigned_right = re.atomicid
),

probe_2ft AS (
    SELECT
        so.globalid,
        lp.atomicid AS left_atomicid,
        rp.atomicid AS right_atomicid
    FROM scoped AS sc
    INNER JOIN "cscl"."ar_cscl_duckdb_build"."int__segment_offsets" AS so ON sc.globalid = so.globalid
    LEFT JOIN "cscl"."ar_cscl_duckdb_build"."stg__atomicpolygons" AS lp ON st_within(so.left_offset_point, lp.geom)
    LEFT JOIN "cscl"."ar_cscl_duckdb_build"."stg__atomicpolygons" AS rp ON st_within(so.right_offset_point, rp.geom)
    WHERE sc.method IN ('out_of_scope', 'bad_geom')
)

SELECT
    sc.globalid,
    sc.segmentid,
    sc.method,
    CASE WHEN p2.globalid IS NOT NULL THEN p2.left_atomicid ELSE sc.assigned_left END AS topo_left_atomicid,
    CASE WHEN p2.globalid IS NOT NULL THEN p2.right_atomicid ELSE sc.assigned_right END AS topo_right_atomicid,
    CASE
        WHEN p2.globalid IS NOT NULL THEN 'probe_2ft'
        WHEN sc.left_from_edge THEN 'edge'
        ELSE 'probe'
    END AS topo_left_source,
    CASE
        WHEN p2.globalid IS NOT NULL THEN 'probe_2ft'
        WHEN sc.right_from_edge THEN 'edge'
        ELSE 'probe'
    END AS topo_right_source,
