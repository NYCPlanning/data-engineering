    create  table
      "cscl"."ar_cscl_duckdb_build"."gdb_nysswi__dbt_tmp"
  
    
    as (
      

-- State senate districts, water included (the *wi variant). Boundaries come from the
-- AtomicPolygon topology (int__boundary__sswi); columns, column order and types match
-- the published layer.

WITH boundaries AS (
    SELECT
        entity_id,
        st_multi(geom) AS geom
    FROM "cscl"."ar_cscl_duckdb_build"."int__boundary__sswi"
)

SELECT
    b.entity_id::smallint AS "StSenDist",
    b.geom,
    st_perimeter(b.geom) AS "SHAPE_Length",
    st_area(b.geom) AS "SHAPE_Area"
FROM boundaries AS b
    );
    
  
