SELECT
    st.globalid,
    st.idx_a,
    st.idx_b,
    st.node_a,
    st.node_b,
    st.step_len,
    CASE
        WHEN m.globalid IS NOT NULL THEN m.match_type
        WHEN st.node_a = st.node_b AND st.step_len <= 0.25 THEN 'same_node'
        ELSE 'none'
    END AS match_type,
    m.hop,
    m.from_node,
    m.to_node,
    m.is_arc,
    m.along_start,
    m.along_end,
    -- half-open, so exactly one matched edge holds the midpoint
    coalesce(m.along_start <= st.seg_len / 2 AND st.seg_len / 2 < m.along_end, FALSE) AS covers_midpoint,
    m.len_diff AS len_diff_ft,
    m.offset_ft
FROM steps AS st
