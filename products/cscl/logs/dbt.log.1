    b.geom,
    st_perimeter(b.geom) AS "SHAPE_Length",
    st_area(b.geom) AS "SHAPE_Area"
FROM boundaries AS b
LEFT JOIN "cscl"."ar_cscl_duckdb_build"."stg__borough" AS boro ON left(b.entity_id, 1) = boro.borocode
    );
    
  
