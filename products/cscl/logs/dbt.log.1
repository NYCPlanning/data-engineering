    create  table
      "cscl"."ar_cscl_duckdb_build"."last_word__dbt_tmp"
  
    
    as (
      WITH word_table AS (
    SELECT * FROM "cscl"."ar_cscl_duckdb_build"."dcp_cscl_lastword"
),
ranked AS (
    SELECT
        LEFT(full_name, 1) AS first_letter,
        ROW_NUMBER() OVER (PARTITION BY LEFT(full_name, 1) ORDER BY full_name) AS row_number,
        *
    FROM word_table
)
SELECT
