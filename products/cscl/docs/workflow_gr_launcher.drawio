        <mxCell id="e6" value="3 · ingest" style="edgeStyle=orthogonalEdgeStyle;html=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="private" target="recipes">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="-12" as="offset"/>
          </mxGeometry>
        </mxCell>
        <mxCell id="e7" value="4 · load + dbt" style="edgeStyle=orthogonalEdgeStyle;html=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="recipes" target="pg">
