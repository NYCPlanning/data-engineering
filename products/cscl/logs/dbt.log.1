    create  table
      "cscl"."ar_cscl_duckdb_build"."int__boundary__hc_raw__dbt_tmp"
  
    
    as (
      

-- One row per health center district, from its exterior edges, before noise-ring removal.

WITH faces AS (
    SELECT
        entity_id,
        unnest(st_dump(polygonized)).geom AS face
    FROM (
        SELECT
            entity_id,
            st_polygonize(list(geom)) AS polygonized
        FROM "cscl"."ar_cscl_duckdb_build"."int__boundary__hc_edges"
        WHERE edge_type = 'exterior'
        GROUP BY entity_id
    ) AS by_entity
),

member_points AS (
    SELECT
        m.health_center AS entity_id,
        st_pointonsurface(a.geom) AS pt
    FROM "cscl"."ar_cscl_duckdb_build"."int__topology__ap_entities" AS m
    INNER JOIN "cscl"."ar_cscl_duckdb_build"."stg__atomicpolygons" AS a ON m.atomicid = a.atomicid
    WHERE
        m.health_center IS NOT NULL
        AND m.water_flag != '1'
),

kept AS (
    SELECT
        f.entity_id,
        f.face
    FROM faces AS f
    WHERE EXISTS (
        SELECT 1 FROM member_points AS mp
        WHERE mp.entity_id = f.entity_id AND st_contains(f.face, mp.pt)
    )
)

-- kept faces share exact, already-noded edges, so this union only dissolves them
SELECT
    entity_id,
    st_union_agg(face) AS geom
FROM kept
GROUP BY entity_id

    );
    
  
