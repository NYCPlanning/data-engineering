  create view "cscl"."ar_cscl_duckdb_build"."stg__altsegmentdata_proto__dbt_tmp" as (
    SELECT
    'altsegmentdata' AS source_table,
    segmentid,
    lionkey,
    RIGHT(b5sc, 5) AS five_digit_street_code,
    b5sc || lgc1 AS b7sc,
    saftype,
    l_low_hn,
    l_high_hn,
    r_low_hn,
    r_high_hn,
    low_hn_suffix,
    high_hn_suffix,
    lgc1,
    lgc2,
