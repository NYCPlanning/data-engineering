  create view "cscl"."ar_cscl_duckdb_build"."int__special_sedat__dbt_tmp" as (
    WITH special_sedat AS (
    SELECT * FROM "cscl"."ar_cscl_duckdb_build"."dcp_cscl_specialsedat"
